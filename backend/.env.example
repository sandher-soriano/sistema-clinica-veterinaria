# ============================================================
# Premier Can - plantilla de configuración
# Copia este archivo como ".env" (en esta misma carpeta) y completa
# los valores. El .env real NUNCA se sube a git (tiene contraseñas).
# ============================================================
PORT=4000

# --- SQL Server local (lo crea backend/scripts/crear-bd.js) ---
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=PremierCanDB
DB_USER=premiercan_app
DB_PASSWORD=pon-aqui-una-contraseña-larga
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- Sesiones (JWT): texto aleatorio largo, distinto en cada instalación ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Dirección pública (ngrok u otra): para CORS y enlaces de los correos ---
FRONTEND_ORIGIN=https://tu-dominio.ngrok-free.dev
# Dominio fijo de ngrok (sin https://) que abre iniciar-premiercan.bat
NGROK_DOMAIN=tu-dominio.ngrok-free.dev

# --- Correo (opcional). Sin configurar, los enlaces se muestran en la consola ---
# Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación"
CORREO_PROVEEDOR=gmail
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE="Premier Can <tucorreo@gmail.com>"

# Mailgun (alternativa)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_REGION=

# --- Validación de DNI con RENIEC (opcional): "decolecta" o "apisnet" ---
RENIEC_PROVIDER=decolecta
RENIEC_API_TOKEN=

# --- Consulta de RUC de proveedores en SUNAT (apis.net.pe) ---
# Funciona SIN token (gratis, con cupo diario). Si te registras en apis.net.pe
# y obtienes un token, ponlo aquí para tener más consultas.
RUC_API_TOKEN=

# --- Teléfono de soporte que ve el cliente ---
SOPORTE_TELEFONO=
